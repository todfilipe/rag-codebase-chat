# Credenciais do núcleo RAG. Só o serviço Python as vê — a camada Next.js
# não tem, nem precisa de ter, acesso à Gemini, à GitHub ou ao Supabase.

GEMINI_API_KEY=
GITHUB_TOKEN=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo partilhado com o Next.js. Tem de ser igual ao RAG_SERVICE_TOKEN
# do .env.local da raiz. Gera um com: openssl rand -hex 32
RAG_SERVICE_TOKEN=
